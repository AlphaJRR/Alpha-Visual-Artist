# Vite / Cloudflare Pages build (copy to .env.local for local dev — never commit real keys)
PORT=18606
BASE_PATH=/

# Required for client sign-in (Clerk Dashboard → API Keys → Publishable key)
VITE_CLERK_PUBLISHABLE_KEY=pk_live_or_pk_test_your_key_here

# Set true only when /api is proxied to the Replit api-server (not on static Pages alone)
VITE_PORTAL_API_ENABLED=false

# ALPHA Creators app landing + Sunday launch
VITE_APP_STORE_URL=https://apps.apple.com/us/app/alpha-creators/id6770791997
# Flip to true on launch day to swap homepage to AppLanding
VITE_APP_LAUNCH_LIVE=false

# Klaviyo list signup (public/site key + list ID)
VITE_KLAVIYO_PUBLIC_KEY=
VITE_KLAVIYO_LIST_ID=

# Replit / api-server only (not used by static Vite build)
# DATABASE_URL=
# CLERK_SECRET_KEY=
# CLERK_PUBLISHABLE_KEY=
# SESSION_SECRET=
# AVA_ADMIN_EMAILS=you@example.com
